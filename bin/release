#!/usr/bin/env bash
#
# Cut a release.
#
#   bin/release            # recommend a version from the commits
#   bin/release 1.2.0      # or say which
#
# Drafts the changelog entry, opens it in $EDITOR, writes it to CHANGELOG.md,
# commits, tags (signed), and pushes. The GitHub release page is created by
# .github/workflows/release.yml from the tag, so a tag pushed any other way
# still gets one.
#
# The only step here that needs a person is editing the notes. Everything else
# is bookkeeping, and bookkeeping done by hand is bookkeeping done wrong at
# 6pm on a Friday.

set -euo pipefail

# gh pages its output whenever stdout is a terminal, so a status check turns
# into something you have to quit out of before the release can continue.
export GH_PAGER=""
export PAGER=cat

CWD="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$CWD"

RED=$'\033[1;31m'; GREEN=$'\033[1;32m'; YELLOW=$'\033[1;33m'; DIM=$'\033[2m'; RESET=$'\033[0m'

die() { printf '%s✗%s %s\n' "$RED" "$RESET" "$1" >&2; exit 1; }
step() { printf '\n%s==>%s %s\n' "$YELLOW" "$RESET" "$1"; }
note() { printf '    %s%s%s\n' "$DIM" "$1" "$RESET"; }

# ------------------------------------------------------------------ checks --

command -v gh >/dev/null || die "gh is not installed"
gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run: gh auth login"

[ -z "$(git status --porcelain)" ] || die "working tree is not clean"

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
[ "$BRANCH" = "master" ] || die "releases are cut from master, not $BRANCH"

git fetch --quiet origin master --tags
LOCAL="$(git rev-parse @)"
REMOTE="$(git rev-parse "@{u}")"
[ "$LOCAL" = "$REMOTE" ] || die "master and origin/master have diverged — push or pull first"

# A release is a claim that this code works. CI is the evidence, and a tag
# cannot be taken back once it is pushed.
step "Checking CI for $(git rev-parse --short HEAD)"

RUNS="$(gh run list --branch master --commit "$LOCAL" --limit 50 \
    --json name,status,conclusion --jq '.[] | "\(.status)\t\(.conclusion // "")\t\(.name)"' 2>/dev/null || true)"

CI_TOTAL="$(printf '%s' "$RUNS" | grep -c . || true)"
# Anything not finished, and anything finished badly. A run still going is not
# evidence of anything, and treating it as green is how a release gets cut
# while the acceptance matrix is still deciding.
CI_PENDING="$(printf '%s\n' "$RUNS" | awk -F'\t' '$1 != "completed"' | grep -c . || true)"
CI_FAILED="$(printf '%s\n' "$RUNS" | awk -F'\t' '$1 == "completed" && $2 != "success" && $2 != "skipped"' | grep -c . || true)"

if [ "$CI_TOTAL" = "0" ]; then
    note "no CI runs found for this commit"
    read -r -p "    Continue without CI evidence? [y/N] " reply
    [ "$reply" = "y" ] || die "stopped"
elif [ "$CI_FAILED" != "0" ]; then
    printf '%s\n' "$RUNS" | awk -F'\t' '$1 == "completed" && $2 != "success" && $2 != "skipped" { printf "    %s  %s\n", $2, $3 }'
    die "CI is not green for this commit"
elif [ "$CI_PENDING" != "0" ]; then
    printf '%s\n' "$RUNS" | awk -F'\t' '$1 != "completed" { printf "    %s  %s\n", $1, $3 }'
    die "CI has not finished for this commit — wait for it, then run again"
else
    note "$CI_TOTAL run(s), all green"
fi

# The five-image matrix is label-gated, so green can mean the smoke leg alone.
if ! printf '%s\n' "$RUNS" | awk -F'\t' '{ print $3 }' | grep -q '^Acceptance$'; then
    note "no Acceptance run for this commit — the five-image matrix is what a release needs"
    read -r -p "    Continue anyway? [y/N] " reply
    [ "$reply" = "y" ] || die "stopped"
fi

# ----------------------------------------------------------------- version --

LAST_TAG="$(git describe --tags --abbrev=0 2>/dev/null || echo '')"

if [ -n "$LAST_TAG" ]; then
    RANGE="$LAST_TAG..HEAD"
    note "since $LAST_TAG"
else
    RANGE=""
    note "no previous tag — this is the first release"
fi

SUBJECTS="$(git log --no-merges --format=%s ${RANGE:+"$RANGE"})"
[ -n "$SUBJECTS" ] || die "no commits since $LAST_TAG"

# Recommendation only. Conventional commits describe the change, not how much
# a store has to care, and that is a judgement call.
BUMP="patch"
echo "$SUBJECTS" | grep -qE '^[a-z]+(\([^)]*\))?!:' && BUMP=major
[ "$BUMP" = "patch" ] && echo "$SUBJECTS" | grep -qE '^feat(\([^)]*\))?:' && BUMP=minor
git log --no-merges --format=%B ${RANGE:+"$RANGE"} | grep -q '^BREAKING CHANGE:' && BUMP=major

CURRENT="${LAST_TAG#v}"
CURRENT="${CURRENT:-0.0.0}"
IFS=. read -r MA MI PA <<< "$CURRENT"
MA="${MA:-0}"; MI="${MI:-0}"; PA="${PA:-0}"

case "$BUMP" in
    major) SUGGESTED="$((MA + 1)).0.0" ;;
    minor) SUGGESTED="${MA}.$((MI + 1)).0" ;;
    patch) SUGGESTED="${MA}.${MI}.$((PA + 1))" ;;
esac

VERSION="${1:-}"

if [ -z "$VERSION" ]; then
    step "Version"
    note "$(echo "$SUBJECTS" | wc -l | tr -d ' ') commits suggest a $BUMP release"
    read -r -p "    Version [$SUGGESTED]: " VERSION
    VERSION="${VERSION:-$SUGGESTED}"
fi

VERSION="${VERSION#v}"
echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' \
    || die "\"$VERSION\" is not a semantic version"

TAG="v$VERSION"
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null && die "$TAG already exists locally"
git ls-remote --exit-code --tags origin "$TAG" >/dev/null 2>&1 && die "$TAG already exists on origin"
grep -qE "^## +v?${VERSION//./\\.}( |$)" CHANGELOG.md && die "CHANGELOG.md already has a section for $VERSION"

# ---------------------------------------------------------------- the notes --

DRAFT="$(mktemp -t mpi-release)"
trap 'rm -f "$DRAFT" "$DRAFT.bak"' EXIT

# The guide is an HTML comment, not a #-prefixed one. These notes are markdown,
# and every heading in them starts with #, so stripping "# comments" the way a
# commit template does deletes ## 1.0.0 and ### Security along with the guide.
{
    bin/changelog-draft ${LAST_TAG:+"$LAST_TAG"} 2>/dev/null \
        | sed "1s/^## X\.Y\.Z/## $VERSION/"
    cat <<'EOF'

<!-- ----------------------------------------------------------------------
Everything from this line down is ignored.

This becomes the CHANGELOG entry and the GitHub release body. It is read by
one person asking one question: do I need to deploy this to a production
store today?

  - Anything that changes whether a store ends up patched goes under
    "### Security", first. That is what this section is read for.
  - Rewrite subjects for someone who has not seen the diff.
  - Delete what does not matter to them. Most of it will not.

Leave only this comment to abort.
----------------------------------------------------------------------- -->
EOF
} > "$DRAFT"

step "Editing the notes for $TAG"
"${EDITOR:-vim}" "$DRAFT"

# Everything before the guide, minus trailing blank lines.
NOTES="$(sed '/^<!--/,$d' "$DRAFT" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')"

# The heading alone is not an entry: a release with nothing to say about it is
# a release nobody can decide about.
[ -n "$(echo "$NOTES" | sed '1d' | tr -d '[:space:]')" ] || die "notes are empty — nothing released"

step "This is the release"
printf '%s\n' "$NOTES" | sed 's/^/    /'

printf '\n'
read -r -p "    Tag $TAG and push? [y/N] " reply
[ "$reply" = "y" ] || die "stopped — nothing was written"

# ------------------------------------------------------------------- write --

step "Writing CHANGELOG.md"
python3 - "$VERSION" "$NOTES" <<'PY'
import re, sys, datetime

version, notes = sys.argv[1], sys.argv[2].strip()

# The draft's heading carries the version; stamp it with today's date.
notes = re.sub(r'^## +\S+.*$', f'## {version} — {datetime.date.today().isoformat()}', notes, count=1)

lines = open("CHANGELOG.md").read().split("\n")
out, i, inserted = [], 0, False

while i < len(lines):
    if re.match(r'^## +Unreleased\s*$', lines[i]):
        # Keep the heading for next time, replace its body with the release.
        out += [lines[i], "", "Nothing yet.", ""]
        out += notes.split("\n")
        out += [""]
        inserted = True
        i += 1
        while i < len(lines) and not lines[i].startswith("## "):
            i += 1
        continue

    out.append(lines[i])
    i += 1

if not inserted:
    for j, line in enumerate(out):
        if line.startswith("## "):
            out[j:j] = notes.split("\n") + [""]
            break
    else:
        out += [""] + notes.split("\n")

open("CHANGELOG.md", "w").write("\n".join(out).rstrip("\n") + "\n")
PY

git add CHANGELOG.md
git commit -q -m "chore(release): $VERSION"

step "Tagging $TAG"

# No silent fallback. This used to drop to an annotated tag with a one-line
# note, which scrolled past and produced an unsigned release nobody noticed
# until someone looked for the Verified badge. A misconfigured signing key is
# a thing to fix, not to work around — and the changelog commit is already
# made, so the fix is: sort the key, then re-run with the same version.
if ! git tag -s "$TAG" -m "$TAG"; then
    printf '\n'
    note "the changelog commit is made but nothing is pushed, and $TAG does not exist"
    note "fix signing, then: bin/release $VERSION"
    note "or tag it unsigned on purpose: git tag -a $TAG -m $TAG"
    die "could not sign $TAG"
fi

step "Pushing"
git push -q origin master
git push -q origin "$TAG"

printf '\n%s✓%s %s pushed. The release workflow builds the page from CHANGELOG.md.\n' "$GREEN" "$RESET" "$TAG"
note "gh run watch \$(gh run list --workflow Release --limit 1 --json databaseId --jq '.[0].databaseId')"
note "https://packagist.org/packages/samjuk/magento-patch-installer"
